# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
STUDENT_DB_NAME=student_finder_db
HOSTEL_DB_NAME=hostel_finder_db

# Specific Database URIs (Optional - can also specify individually)
# STUDENT_DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/student_finder_db?retryWrites=true&w=majority
# HOSTEL_DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hostel_finder_db?retryWrites=true&w=majority

# JWT Secret Configuration
JWT_SECRET=staynear_vadodara_jwt_super_secret_key_2026_student_finder
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Maps API (Optional for external distance/geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client URL for CORS
CLIENT_URL=http://localhost:3000
